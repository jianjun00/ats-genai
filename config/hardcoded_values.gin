agents.agent_networks.NetworkConfig.num_agents = 10
agents.agent_networks.NetworkConfig.interaction_type = "graph_attention"
agents.agent_networks.NetworkConfig.graph_topology = "dynamic"
agents.agent_networks.NetworkConfig.communication_rounds = 3
agents.agent_networks.NetworkConfig.consensus_threshold = 0.7
agents.agent_networks.NetworkConfig.enable_learning = True
agents.agent_networks.NetworkConfig.dropout = 0.1
agents.agent_networks.NetworkConfig.temperature = 1.0

# Cross-Scale Attention Configuration
models.attention.cross_scale_attention.AttentionConfig.d_model = 64
models.attention.cross_scale_attention.AttentionConfig.n_heads = 4
models.attention.cross_scale_attention.AttentionConfig.n_scales = 3
models.attention.cross_scale_attention.AttentionConfig.dropout = 0.1
models.attention.cross_scale_attention.AttentionConfig.temperature = 1.0
models.attention.cross_scale_attention.AttentionConfig.use_relative_position = True
models.attention.cross_scale_attention.AttentionConfig.max_relative_position = 512
models.attention.cross_scale_attention.AttentionConfig.max_positional_length = 10000
models.attention.cross_scale_attention.AttentionConfig.scale_embedding_dim = 32