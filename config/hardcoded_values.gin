simple_main.ApiConfig.host = "0.0.0.0"
simple_main.ApiConfig.title = "ATS GenAI API"
simple_main.ApiConfig.description = "Algorithmic Trading System with GenAI"
simple_main.ApiConfig.version = "1.0.0"

api.AnalyticsService.port = 3000
api.DashboardService.port = 4000
api.MetricsService.port = 8080

# CORS configuration  
