paths.logs.coverage_validation = '/logs/coverage_validation.log'

# Backup directories  
paths.backup.root = '/backup'

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Alert thresholds
monitoring.alerts.data_staleness_hours = 24
monitoring.alerts.failure_rate_threshold = 0.10
monitoring.alerts.coverage_threshold = 0.90

# Monitoring intervals
monitoring.intervals.health_check = 300  # 5 minutes
monitoring.intervals.metrics_collection = 60  # 1 minute
monitoring.intervals.alert_check = 600  # 10 minutes

# Cleanup retention periods (days)
monitoring.retention.logs = 30
monitoring.retention.metrics = 90
monitoring.retention.alerts = 7

# =============================================================================
# EXTERNAL SERVICE CONFIGURATION
# =============================================================================

# FRED API configuration
