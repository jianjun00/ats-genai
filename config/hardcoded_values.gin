dates.lookback.medium_term = 90
dates.lookback.long_term = 365

# =============================================================================
# TIMEOUT AND DELAY CONFIGURATION
# =============================================================================

# API timeouts (seconds)
timeouts.api.default = 30
timeouts.api.long_running = 60
timeouts.api.critical = 120

# Database timeouts (seconds)
timeouts.database.connection = 30
timeouts.database.query = 60
timeouts.database.long_query = 300

# Rate limiting delays (seconds)
delays.rate_limit.default = 1.0
delays.rate_limit.aggressive = 0.5
delays.rate_limit.conservative = 2.0

# Retry delays (seconds)
delays.retry.initial = 1
delays.retry.backoff_multiplier = 2
delays.retry.max_delay = 60

# =============================================================================
# BATCH PROCESSING CONFIGURATION
# =============================================================================

# Batch sizes
batch.sizes.small = 10
batch.sizes.default = 100
batch.sizes.large = 1000
batch.sizes.maximum = 10000

# API limits
batch.api.polygon_limit = 1000
batch.api.fred_limit = 100000
batch.api.tiingo_limit = 500
batch.api.default_limit = 50

# Processing limits
batch.processing.max_symbols = 1000
batch.processing.max_days = 365
batch.processing.max_concurrent = 5

