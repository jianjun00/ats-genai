# Production Environment Configuration Template
# Copy this file to production.env and update with actual values

# Database Configuration
DB_HOST=ats-prod-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PRODUCTION_PASSWORD_HERE
DB_NAME=prod_db

# Agent Configuration
AGENT_ENVIRONMENT=production
AGENT_LOG_LEVEL=INFO
AGENT_MONITORING_INTERVAL=300  # 5 minutes
AGENT_MAX_CONCURRENT_WORKFLOWS=20

# API Keys (Required for data collection)
POLYGON_API_KEY=YOUR_POLYGON_API_KEY_HERE
TIINGO_API_KEY=YOUR_TIINGO_API_KEY_HERE
EODHD_API_KEY=YOUR_EODHD_API_KEY_HERE

# Alert Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=true
EMAIL_SMTP_SERVER=smtp.your-company.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=alerts@your-company.com
EMAIL_SMTP_PASSWORD=YOUR_EMAIL_PASSWORD_HERE
EMAIL_RECIPIENTS=team@your-company.com,ops@your-company.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#data-quality-alerts

# System Monitoring Thresholds
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=85
MEMORY_WARNING_THRESHOLD=80
MEMORY_CRITICAL_THRESHOLD=90
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# Performance Configuration
MAX_NOTIFICATIONS_PER_HOUR=20
ALERT_COOLDOWN_MINUTES=30
STALL_THRESHOLD_MINUTES=60

# Logging Configuration
LOG_RETENTION_DAYS=30
STRUCTURED_LOGGING=true
LOG_LEVEL=INFO

# Security Configuration
ENABLE_API_AUTH=false  # Set to true for production
API_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30