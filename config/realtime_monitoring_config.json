{
  "description": "ATS Real-time Collection Monitoring System Configuration",
  "version": "1.0",
  "last_updated": "2025-09-02",
  
  "components": {
    "monitor": {
      "enabled": true,
      "interval_seconds": 60,
      "database": {
        "host": "ats-intg-postgres",
        "port": 5432,
        "user": "postgres",
        "password": "intg_password",
        "database": "intg_db"
      },
      "symbols": ["AAPL", "TSLA"],
      "vendors": ["tiingo", "polygon"],
      "thresholds": {
        "data_freshness_minutes": 5,
        "quality_score_min": 0.7,
        "price_divergence_pct": 5.0,
        "collection_rate_min": 0.8,
        "volume_anomaly_factor": 3.0,
        "price_spike_pct": 10.0
      }
    },
    
    "alerting": {
      "enabled": true,
      "test_on_startup": true,
      "channels": {
        "slack": {
          "enabled": true,
          "webhook_url": "https://hooks.slack.com/services/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",
          "min_level": "warning",
          "rate_limit_minutes": 5,
          "channel": "#ats-alerts",
          "username": "ATS Real-time Monitor",
          "icon_emoji": ":chart_with_upwards_trend:"
        },
        "email": {
          "enabled": true,
          "recipients": ["jianjun00@gmail.com"],
          "min_level": "critical",
          "rate_limit_minutes": 15,
          "smtp_config": {
            "server": "smtp.gmail.com",
            "port": 587,
            "use_tls": true,
            "subject_prefix": "[ATS-ALERT]"
          }
        },
        "discord": {
          "enabled": false,
          "webhook_url": null,
          "min_level": "info"
        }
      }
    },
    
    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8090,
      "update_interval_seconds": 30,
      "websocket_enabled": true,
      "api_enabled": true
    },
    
    "prometheus": {
      "enabled": true,
      "port": 8091,
      "existing_prometheus_url": "http://localhost:8080",
      "metrics_retention_hours": 24,
      "include_alerting_rules": true,
      "include_grafana_dashboard": true
    }
  },
  
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "/mnt/d/ats-logs/realtime_monitoring.log",
    "max_size_mb": 100,
    "backup_count": 5
  },
  
  "health_checks": {
    "enabled": true,
    "interval_seconds": 120,
    "restart_on_failure": true,
    "max_restart_attempts": 3,
    "components_to_monitor": ["monitor", "dashboard", "prometheus"]
  },
  
  "data_retention": {
    "metrics_history_hours": 168,
    "alert_history_days": 30,
    "performance_data_days": 7
  },
  
  "performance_settings": {
    "max_concurrent_db_connections": 10,
    "metric_collection_timeout_seconds": 30,
    "websocket_max_connections": 50,
    "prometheus_scrape_timeout_seconds": 10
  },
  
  "security": {
    "dashboard_auth_required": false,
    "api_rate_limiting": true,
    "max_requests_per_minute": 100,
    "trusted_networks": ["127.0.0.1", "localhost"]
  }
}