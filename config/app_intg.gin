# Integration Environment Configuration  
# Inherits base configuration from hardcoded_values.gin and applies integration-specific overrides

include 'config/hardcoded_values.gin'

# Original integration environment configuration
# API keys
finnhub_api_key = 'REPLACE_WITH_ACTUAL_FINNHUB_API_KEY'
iex_api_key = 'REPLACE_WITH_ACTUAL_IEX_API_KEY'
quandl_api_key = 'REPLACE_WITH_ACTUAL_QUANDL_API_KEY'
fmp_api_key = 'REPLACE_WITH_ACTUAL_FMP_API_KEY'
polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'
tiingo_api_key = 'REPLACE_WITH_ACTUAL_TIINGO_API_KEY'

# Features
bind = ['enable_caching', False]
bind = ['enable_metrics', False]
bind = ['strict_validation', True]

# Training Data Job Configuration
TrainingDataJobConfig.base_interval_minutes = 1
TrainingDataJobConfig.training_interval_minutes = 60
TrainingDataJobConfig.output_structure = "hourly_rows"
TrainingDataJobConfig.normalize_features = False
TrainingDataJobConfig.normalize_labels = False
TrainingDataJobConfig.use_enhanced_features = True
TrainingDataJobConfig.use_universe_state_indicators = True

# Original Database Configuration
Database.host = 'localhost'
Database.port = 5432
Database.user = 'postgres'
Database.password = 'REPLACE_WITH_ACTUAL_DB_PASSWORD'
Database.database = 'intg_db'
Database.pool_min_size = 1
Database.pool_max_size = 10
Database.command_timeout = 60

bind = ['database.host', 'localhost']
bind = ['database.port', 5432]
bind = ['database.user', 'postgres']
bind = ['database.password', 'password']
bind = ['database.database', 'intg_db']
bind = ['database.pool_min_size', 1]
bind = ['database.pool_max_size', 10]
bind = ['database.command_timeout', 60]

# =============================================================================
# INTEGRATION ENVIRONMENT OVERRIDES
# =============================================================================

# Integration Database Configuration
database.connection.host = 'localhost'
database.connection.port = 4432
database.connection.user = 'postgres'
database.connection.password = 'intg_password'
database.connection.database = 'intg_db'
database.connection.pool_min_size = 2
database.connection.pool_max_size = 10
database.connection.command_timeout = 90

# Integration API Configuration
api.backtest_analytics_api.BacktestServerConfig.host = "0.0.0.0"
api.backtest_analytics_api.BacktestServerConfig.port = 4000
api.backtest_analytics_api.BacktestServerConfig.reload = false
api.backtest_analytics_api.BacktestServerConfig.log_level = "info"

# Integration CORS - Allow CI/CD and staging frontend access
main.CORSConfig.allow_origins = ["http://localhost:4000", "http://staging.ats.local", "http://ci-runner:*"]
api.backtest_analytics_api.BacktestCORSConfig.allow_origins = ["http://localhost:4000", "http://staging.ats.local", "http://ci-runner:*"]

# Integration Real-time Data Collector
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_host = "ats-intg-postgres"
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_port = 5432
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_password = "intg_password"
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_name = "intg_db"

# Integration connection pool - moderate for CI/CD testing
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.pool_min_size = 2
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.pool_max_size = 8

# Integration timeouts - balanced for automated testing
timeouts.api.default = 45
timeouts.api.long_running = 90
timeouts.database.connection = 45
timeouts.database.query = 90

# Integration batch sizes - moderate for comprehensive testing
batch.sizes.default = 50
batch.sizes.large = 200
batch.processing.max_symbols = 500

# Integration symbol universe - broader coverage for testing
symbols.default_universe = ['AAPL', 'TSLA', 'MSFT', 'GOOGL', 'AMZN', 'META']
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.symbols = ["AAPL", "TSLA", "MSFT"]
services.minute.minute_price_service.MinuteServiceConfig.default_symbols = ["AAPL", "TSLA", "MSFT", "GOOGL"]

# Integration monitoring - production-like monitoring
monitoring.intervals.health_check = 120  # 2 minutes
monitoring.intervals.metrics_collection = 60
monitoring.alerts.failure_rate_threshold = 0.15

# Integration data paths
paths.data.root = '/mnt/d/ats-intg-data'
paths.logs.root = '/mnt/d/ats-intg-logs'
paths.backup.root = '/mnt/d/ats-intg-backup'

# Integration ML configuration - production-sized for testing
agents.agent_networks.AgentConfig.hidden_dim = 256
agents.agent_networks.AgentConfig.memory_horizon = 60
agents.agent_networks.NetworkConfig.num_agents = 10
models.attention.cross_scale_attention.AttentionConfig.d_model = 64
models.attention.cross_scale_attention.AttentionConfig.n_heads = 4

# Integration external APIs - production rate limits for testing
external.polygon.rate_limit_per_minute = 4
external.tiingo.rate_limit_per_hour = 500
delays.rate_limit.default = 1.5

# Integration date ranges - broader for comprehensive testing
dates.default_start = '2024-01-01'
dates.default_end = '2024-12-31'
dates.lookback.default_days = 30

# Integration thresholds - production-level requirements
thresholds.success_rate = 0.85
thresholds.data_coverage = 0.90
thresholds.api_success = 0.75

# Integration Authentication - production-like settings
AuthenticationConfig.free_tier_daily_limit = 24  # Standard production limit
AuthenticationConfig.api_key_length = 32
AuthenticationConfig.rate_limit_reset_seconds = 86400  # 24 hours
AuthenticationConfig.premium_unlimited = True
AuthenticationConfig.log_invalid_attempts = True
AuthenticationConfig.track_usage = True
