# Gin config for market-forecast-app (integration environment)

# API keys
finnhub_api_key = 'intg_finnhub_key'
iex_api_key = 'intg_iex_key'
quandl_api_key = 'intg_quandl_key'
fmp_api_key = 'intg_fmp_key'
polygon_api_key = 'intg_polygon_key'
tiingo_api_key = 'intg_tiingo_key'

# Logging
bind = ['logging.level', 'INFO']
bind = ['logging.format', '%(asctime)s - %(name)s - %(levelname)s - %(message)s']

# Features
bind = ['enable_caching', False]
bind = ['enable_metrics', False]
bind = ['strict_validation', True]

# Runner
#bind = ['callbacks', 'state.universe_state_builder.UniverseStateBuilder']
#bind = ['saved_dir', '/tmp/intg_universe_states']

# Durations for UniverseStateBuilder
state.universe_state_builder.UniverseStateBuilder.base_duration = '5m'
state.universe_state_builder.UniverseStateBuilder.target_durations = '5m,15m,60m'

# Database
bind = ['database.host', 'localhost']
bind = ['database.port', 5432]
bind = ['database.user', 'postgres']
bind = ['database.password', 'password']
bind = ['database.database', 'intg_db']
bind = ['database.pool_min_size', 1]
bind = ['database.pool_max_size', 10]
bind = ['database.command_timeout', 60]
