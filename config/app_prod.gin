# Gin config for market-forecast-app (production environment)

# API keys
finnhub_api_key = 'REPLACE_WITH_ACTUAL_FINNHUB_API_KEY'
iex_api_key = 'REPLACE_WITH_ACTUAL_IEX_API_KEY'
quandl_api_key = 'REPLACE_WITH_ACTUAL_QUANDL_API_KEY'
fmp_api_key = 'REPLACE_WITH_ACTUAL_FMP_API_KEY'
polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'
tiingo_api_key = 'REPLACE_WITH_ACTUAL_TIINGO_API_KEY'

# Logging
# bind = ['logging.level', 'WARNING']
# bind = ['logging.format', '%(asctime)s - %(name)s - %(levelname)s - %(message)s']
# Use LoggingConfig.log_level and LoggingConfig.log_format if LoggingConfig is used

# Features
bind = ['enable_caching', True]
bind = ['enable_metrics', True]
bind = ['strict_validation', True]

# Runner
bind = ['callbacks', 'state.universe_state_builder.UniverseStateBuilder']
bind = ['saved_dir', '/var/universe_states']

# Database
bind = ['database.host', 'prod-db-host']
bind = ['database.port', 5432]
bind = ['database.user', 'prod_user']
bind = ['database.password', 'prod_password']
bind = ['database.database', 'prod_trading_db']
bind = ['database.pool_min_size', 2]
bind = ['database.pool_max_size', 20]
bind = ['database.command_timeout', 60]
