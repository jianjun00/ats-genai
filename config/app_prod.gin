# Production Environment Configuration
# Inherits base configuration from hardcoded_values.gin and applies production-specific overrides

include 'config/hardcoded_values.gin'

# Original production environment configuration
# API keys
finnhub_api_key = 'REPLACE_WITH_ACTUAL_FINNHUB_API_KEY'
iex_api_key = 'REPLACE_WITH_ACTUAL_IEX_API_KEY'
quandl_api_key = 'REPLACE_WITH_ACTUAL_QUANDL_API_KEY'
fmp_api_key = 'REPLACE_WITH_ACTUAL_FMP_API_KEY'
polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'
tiingo_api_key = 'REPLACE_WITH_ACTUAL_TIINGO_API_KEY'

# Features
bind = ['enable_caching', True]
bind = ['enable_metrics', True]
bind = ['strict_validation', True]

# Runner
bind = ['callbacks', 'state.universe_state_builder.UniverseStateBuilder']
bind = ['saved_dir', '/var/universe_states']

# Original Database Configuration
bind = ['database.host', 'prod-db-host']
bind = ['database.port', 5432]
bind = ['database.user', 'prod_user']
bind = ['database.password', 'prod_password']
bind = ['database.database', 'prod_trading_db']
bind = ['database.pool_min_size', 2]
bind = ['database.pool_max_size', 20]
bind = ['database.command_timeout', 60]

# =============================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# =============================================================================

# Production Database Configuration
database.connection.host = 'prod-db-cluster.ats.internal'
database.connection.port = 5432
database.connection.user = 'ats_prod_user'
database.connection.password = 'REPLACE_WITH_VAULT_PASSWORD'
database.connection.database = 'ats_production'
database.connection.pool_min_size = 5
database.connection.pool_max_size = 50
database.connection.command_timeout = 30

# Production API Configuration
api.backtest_analytics_api.BacktestServerConfig.host = "0.0.0.0"
api.backtest_analytics_api.BacktestServerConfig.port = 8000
api.backtest_analytics_api.BacktestServerConfig.reload = false
api.backtest_analytics_api.BacktestServerConfig.log_level = "warning"

# Production CORS - Restrict to production domains only
main.CORSConfig.allow_origins = ["https://ats.production.com", "https://dashboard.ats.production.com"]
api.backtest_analytics_api.BacktestCORSConfig.allow_origins = ["https://ats.production.com", "https://api.ats.production.com"]

# Production Real-time Data Collector
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_host = "prod-db-cluster.ats.internal"
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_port = 5432
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_password = "REPLACE_WITH_VAULT_PASSWORD"
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.db_name = "ats_production"

# Production connection pool - optimized for high throughput
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.pool_min_size = 10
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.pool_max_size = 100

# Production timeouts - strict for performance
timeouts.api.default = 30
timeouts.api.long_running = 60
timeouts.database.connection = 30
timeouts.database.query = 60

# Production batch sizes - optimized for throughput
batch.sizes.default = 1000
batch.sizes.large = 5000
batch.processing.max_symbols = 10000

# Production symbol universe - full market coverage
symbols.default_universe = [
    'AAPL', 'MSFT', 'GOOGL', 'GOOG', 'AMZN', 'TSLA', 'META', 'NVDA',
    'JPM', 'V', 'JNJ', 'WMT', 'PG', 'MA', 'UNH', 'HD', 'BAC', 'ABBV',
    'CRM', 'PFE', 'KO', 'AVGO', 'PEP', 'TMO', 'COST', 'DIS', 'ABT'
]
market_data.realtime.aapl_tsla_realtime_collector.RealtimeCollectorConfig.symbols = symbols.default_universe
services.minute.minute_price_service.MinuteServiceConfig.default_symbols = symbols.default_universe

# Production monitoring - strict thresholds
monitoring.intervals.health_check = 300  # 5 minutes
monitoring.intervals.metrics_collection = 60
monitoring.alerts.failure_rate_threshold = 0.05

# Production data paths
paths.data.root = '/var/ats/data'
paths.logs.root = '/var/ats/logs'
paths.backup.root = '/var/ats/backup'

# Production ML configuration - full scale
agents.agent_networks.AgentConfig.hidden_dim = 512
agents.agent_networks.AgentConfig.memory_horizon = 120
agents.agent_networks.NetworkConfig.num_agents = 50
models.attention.cross_scale_attention.AttentionConfig.d_model = 128
models.attention.cross_scale_attention.AttentionConfig.n_heads = 8

# Production external APIs - maximize rate limits
external.polygon.rate_limit_per_minute = 5
external.tiingo.rate_limit_per_hour = 1000
delays.rate_limit.default = 1.0

# Production date ranges - comprehensive historical data
dates.default_start = '2020-01-01'
dates.default_end = '2024-12-31'
dates.lookback.default_days = 365

# Production thresholds - strict requirements
thresholds.success_rate = 0.95
thresholds.data_coverage = 0.99
thresholds.api_success = 0.90

# Production security and performance
LoggingConfig.log_level = 'WARNING'
monitoring.retention.logs = 90
monitoring.retention.metrics = 365
monitoring.retention.alerts = 30
