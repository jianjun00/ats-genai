# Simple Working Configurable Training Data Generation
# This configuration uses only basic transforms that don't require external indicators

# Import necessary modules
import signals.feature_registry
import signals.label_registry
import modeling.configurable_train_data_generator

# ===== SIMPLE FEATURE CONFIGURATION =====

# Price returns (simple percentage change)
returns_1d/create_feature_config.name = "returns_1d"
returns_1d/create_feature_config.feature_type = "transform"
returns_1d/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
returns_1d/create_feature_config.lag_periods = 1
returns_1d/create_feature_config.enabled = True

# Price returns lagged 2 days
returns_2d_lag/create_feature_config.name = "returns_2d_lag"
returns_2d_lag/create_feature_config.feature_type = "transform"
returns_2d_lag/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
returns_2d_lag/create_feature_config.lag_periods = 2
returns_2d_lag/create_feature_config.enabled = True

# Log returns
log_returns/create_feature_config.name = "log_returns"
log_returns/create_feature_config.feature_type = "transform"
log_returns/create_feature_config.parameters = {
    'transform_type': 'log_return',
    'column': 'close'
}
log_returns/create_feature_config.lag_periods = 1
log_returns/create_feature_config.enabled = True

# Rolling volatility (10 day)
volatility_10/create_feature_config.name = "volatility_10d"
volatility_10/create_feature_config.feature_type = "transform"
volatility_10/create_feature_config.parameters = {
    'transform_type': 'volatility',
    'column': 'close',
    'window': 10
}
volatility_10/create_feature_config.lag_periods = 0
volatility_10/create_feature_config.enabled = True

# Volume ratio
volume_ratio/create_feature_config.name = "volume_ratio"
volume_ratio/create_feature_config.feature_type = "transform"
volume_ratio/create_feature_config.parameters = {
    'transform_type': 'volume_ratio',
    'window': 10
}
volume_ratio/create_feature_config.lag_periods = 0
volume_ratio/create_feature_config.enabled = True

# Create feature registry with simple features
create_feature_registry.feature_configs = [
    @returns_1d/create_feature_config(),
    @returns_2d_lag/create_feature_config(),
    @log_returns/create_feature_config(),
    @volatility_10/create_feature_config(),
    @volume_ratio/create_feature_config()
]

# ===== SIMPLE LABEL CONFIGURATION =====

# Future price return (1 day ahead)
future_return_1d/create_label_config.name = "future_return_1d"
future_return_1d/create_label_config.label_type = "return"
future_return_1d/create_label_config.parameters = {
    'return_type': 'simple',
    'column': 'close'
}
future_return_1d/create_label_config.lead_periods = 1
future_return_1d/create_label_config.enabled = True

# Price direction classification (1 day ahead)
price_direction/create_label_config.name = "price_direction_1d"
price_direction/create_label_config.label_type = "classification"
price_direction/create_label_config.parameters = {
    'class_type': 'direction',
    'column': 'close'
}
price_direction/create_label_config.lead_periods = 1
price_direction/create_label_config.enabled = True

# Create label registry with simple labels
create_label_registry.label_configs = [
    @future_return_1d/create_label_config(),
    @price_direction/create_label_config()
]

# ===== TRAINING DATA CONFIGURATION =====
create_configurable_training_data_config.sequence_length = 15  # Shorter sequences
create_configurable_training_data_config.prediction_horizon = 3  # Shorter prediction
create_configurable_training_data_config.feature_registry = @create_feature_registry()
create_configurable_training_data_config.label_registry = @create_label_registry()
create_configurable_training_data_config.normalize_features = True
create_configurable_training_data_config.normalize_labels = False
create_configurable_training_data_config.feature_scaling_method = 'robust'
create_configurable_training_data_config.window_stride = 1
create_configurable_training_data_config.min_valid_ratio = 0.6  # Lower threshold
create_configurable_training_data_config.remove_outliers = False  # Disable for simplicity
create_configurable_training_data_config.output_format = 'pytorch'
create_configurable_training_data_config.device = 'cpu'