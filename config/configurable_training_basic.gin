# Basic Configurable Training Data Generation
# This configuration demonstrates a simple setup with basic technical indicators and price predictions

# Import necessary modules
import signals.feature_registry
import signals.label_registry
import signals.indicator_factory
import modeling.configurable_train_data_generator

# ===== FEATURE CONFIGURATION =====

# Create feature configurations
basic_ema_12/create_feature_config.name = "ema_12"
basic_ema_12/create_feature_config.feature_type = "indicator"
basic_ema_12/create_feature_config.parameters = {
    'indicator_type': 'ema',
    'period': 12
}
basic_ema_12/create_feature_config.lag_periods = 0
basic_ema_12/create_feature_config.enabled = True

basic_ema_26/create_feature_config.name = "ema_26"
basic_ema_26/create_feature_config.feature_type = "indicator"
basic_ema_26/create_feature_config.parameters = {
    'indicator_type': 'ema',
    'period': 26
}
basic_ema_26/create_feature_config.lag_periods = 0
basic_ema_26/create_feature_config.enabled = True

rsi_14/create_feature_config.name = "rsi_14"
rsi_14/create_feature_config.feature_type = "indicator"
rsi_14/create_feature_config.parameters = {
    'indicator_type': 'rsi',
    'period': 14
}
rsi_14/create_feature_config.lag_periods = 0
rsi_14/create_feature_config.enabled = True

price_returns/create_feature_config.name = "returns_1d"
price_returns/create_feature_config.feature_type = "transform"
price_returns/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
price_returns/create_feature_config.lag_periods = 1
price_returns/create_feature_config.enabled = True

volatility_20/create_feature_config.name = "volatility_20d"
volatility_20/create_feature_config.feature_type = "transform"
volatility_20/create_feature_config.parameters = {
    'transform_type': 'volatility',
    'column': 'close',
    'window': 20
}
volatility_20/create_feature_config.lag_periods = 0
volatility_20/create_feature_config.enabled = True

# Create feature registry with basic features
create_feature_registry.feature_configs = [
    @basic_ema_12/create_feature_config(),
    @basic_ema_26/create_feature_config(),
    @rsi_14/create_feature_config(),
    @price_returns/create_feature_config(),
    @volatility_20/create_feature_config()
]

# ===== LABEL CONFIGURATION =====

# Future price return (1 day ahead)
future_return_1d/create_label_config.name = "future_return_1d"
future_return_1d/create_label_config.label_type = "return"
future_return_1d/create_label_config.parameters = {
    'return_type': 'simple',
    'column': 'close'
}
future_return_1d/create_label_config.lead_periods = 1
future_return_1d/create_label_config.enabled = True

# Future price return (5 days ahead)
future_return_5d/create_label_config.name = "future_return_5d"
future_return_5d/create_label_config.label_type = "return"
future_return_5d/create_label_config.parameters = {
    'return_type': 'simple',
    'column': 'close'
}
future_return_5d/create_label_config.lead_periods = 5
future_return_5d/create_label_config.enabled = True

# Price direction classification (1 day ahead)
price_direction/create_label_config.name = "price_direction_1d"
price_direction/create_label_config.label_type = "classification"
price_direction/create_label_config.parameters = {
    'class_type': 'direction',
    'column': 'close'
}
price_direction/create_label_config.lead_periods = 1
price_direction/create_label_config.enabled = True

# Create label registry with basic labels
create_label_registry.label_configs = [
    @future_return_1d/create_label_config(),
    @future_return_5d/create_label_config(),
    @price_direction/create_label_config()
]

# ===== INDICATOR FACTORY =====
create_indicator_factory.feature_registry = @create_feature_registry()
create_indicator_factory.label_registry = @create_label_registry()

# ===== TRAINING DATA CONFIGURATION =====
create_configurable_training_data_config.sequence_length = 30
create_configurable_training_data_config.prediction_horizon = 5
create_configurable_training_data_config.feature_registry = @create_feature_registry()
create_configurable_training_data_config.label_registry = @create_label_registry()
create_configurable_training_data_config.normalize_features = True
create_configurable_training_data_config.normalize_labels = False
create_configurable_training_data_config.feature_scaling_method = 'robust'
create_configurable_training_data_config.window_stride = 1
create_configurable_training_data_config.min_valid_ratio = 0.8
create_configurable_training_data_config.remove_outliers = True
create_configurable_training_data_config.outlier_threshold = 3.0
create_configurable_training_data_config.output_format = 'pytorch'
create_configurable_training_data_config.device = 'cpu'