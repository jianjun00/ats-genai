# Gin config for secmaster integration environment

# Polygon API key
polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'

set_polygon_api_key.polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'

# Database (match integration DB settings)
Database.host = 'localhost'
Database.port = 5432
Database.user = 'postgres'
Database.password = 'REPLACE_WITH_ACTUAL_DB_PASSWORD'
Database.database = 'intg_db'
Database.pool_min_size = 1
Database.pool_max_size = 10
Database.command_timeout = 60

# Features
enable_caching = False
enable_metrics = False
strict_validation = True
