# Gin config for unified populate_unified_instruments integration environment

# Database (integration DB settings)
Database.host = 'localhost'
Database.port = 5432
Database.user = 'postgres'
Database.password = 'password'
Database.database = 'intg_db'
Database.pool_min_size = 1
Database.pool_max_size = 10
Database.command_timeout = 60

# Features
enable_caching = False
enable_metrics = False
strict_validation = True
