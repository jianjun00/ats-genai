{
  "dashboard": {
    "id": null,
    "title": "ATS Batch Jobs Monitoring Dashboard",
    "description": "Monitoring for daily prices backfill jobs across all vendors",
    "tags": ["ats", "batch-jobs", "daily-prices", "backfill", "monitoring"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Daily Prices Sync - Symbols Processed",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(ats_daily_prices_sync_symbols_processed_total[5m])) by (vendor)",
            "legendFormat": "{{vendor}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "mappings": [],
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 1000}
              ]
            },
            "unit": "short",
            "displayName": "Symbols/min"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "pluginVersion": "8.0.0",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
