{
  "dashboard": {
    "id": null,
    "title": "ATS Vendor Monitoring Dashboard (PostgreSQL)",
    "tags": ["ats", "monitoring", "vendors", "minute-bars", "api"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "API Success Rate by Vendor (24h)",
        "type": "stat",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  vendor,\n  COUNT(*) FILTER (WHERE status_code BETWEEN 200 AND 299) * 100.0 / COUNT(*) as success_rate\nFROM intg_api_calls \nWHERE request_timestamp >= NOW() - INTERVAL '24 hours'\nGROUP BY vendor\nORDER BY vendor",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 85},
                {"color": "green", "value": 95}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "API Response Time by Vendor (24h)",
        "type": "timeseries",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  $__time(request_timestamp),\n  vendor,\n  AVG(response_time_ms) as avg_response_time\nFROM intg_api_calls \nWHERE $__timeFilter(request_timestamp)\nGROUP BY $__timeGroup(request_timestamp,'5m'), vendor\nORDER BY 1,2",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "ms"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Minute Bar Records Collected by Vendor",
        "type": "timeseries",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  $__time(collection_timestamp),\n  CONCAT(vendor, ' ', symbol) as vendor_symbol,\n  SUM(records_collected) as total_records\nFROM intg_minute_bar_collection_metrics \nWHERE $__timeFilter(collection_timestamp)\nGROUP BY $__timeGroup(collection_timestamp,'1h'), vendor, symbol\nORDER BY 1,2",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Collection Success Rate by Vendor",
        "type": "gauge",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  CONCAT(vendor, ' ', symbol) as vendor_symbol,\n  COUNT(*) FILTER (WHERE collection_success = true) * 100.0 / COUNT(*) as success_rate\nFROM intg_minute_bar_collection_metrics \nWHERE collection_timestamp >= NOW() - INTERVAL '24 hours'\nGROUP BY vendor, symbol\nORDER BY vendor, symbol",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 98}
              ]
            },
            "min": 0,
            "max": 100,
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "API Status Code Distribution",
        "type": "piechart",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  CONCAT(status_code, ' (', vendor, ')') as status_vendor,\n  COUNT(*) as call_count\nFROM intg_api_calls \nWHERE request_timestamp >= NOW() - INTERVAL '24 hours'\nGROUP BY status_code, vendor\nORDER BY call_count DESC",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 6,
        "title": "Recent API Errors (Last 4 Hours)",
        "type": "table",
        "targets": [
          {
            "datasource": "ATS-INTG-PostgreSQL",
            "rawSql": "SELECT \n  request_timestamp,\n  vendor,\n  endpoint,\n  status_code,\n  response_time_ms,\n  error_message\nFROM intg_api_calls \nWHERE request_timestamp >= NOW() - INTERVAL '4 hours'\n  AND status_code >= 400\nORDER BY request_timestamp DESC\nLIMIT 20",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 30,
    "version": 1
  }
}