{
  "dashboard": {
    "id": null,
    "title": "ATS Daily Prices Validation",
    "tags": ["ats", "data-quality", "daily-prices", "validation"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Missing Prices Count by Vendor",
        "type": "stat",
        "targets": [
          {
            "expr": "ats_daily_prices_missing_count{environment=\"intg\"}",
            "legendFormat": "{{vendor}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 1000}
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value"
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
