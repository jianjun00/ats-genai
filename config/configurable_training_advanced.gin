]

# ===== INDICATOR FACTORY =====
create_indicator_factory.feature_registry = @create_feature_registry()
create_indicator_factory.label_registry = @create_label_registry()

# ===== ADVANCED TRAINING DATA CONFIGURATION =====
create_configurable_training_data_config.sequence_length = 60  # Longer sequences
create_configurable_training_data_config.prediction_horizon = 10  # Longer prediction horizon
create_configurable_training_data_config.feature_registry = @create_feature_registry()
create_configurable_training_data_config.label_registry = @create_label_registry()
create_configurable_training_data_config.normalize_features = True
create_configurable_training_data_config.normalize_labels = True  # Normalize labels too
create_configurable_training_data_config.feature_scaling_method = 'robust'
create_configurable_training_data_config.label_scaling_method = 'standard'
create_configurable_training_data_config.window_stride = 5  # Skip some windows for efficiency
create_configurable_training_data_config.min_valid_ratio = 0.9  # Higher data quality requirement
create_configurable_training_data_config.remove_outliers = True
create_configurable_training_data_config.outlier_threshold = 2.5  # More aggressive outlier removal
create_configurable_training_data_config.output_format = 'pytorch'
create_configurable_training_data_config.device = 'cpu'

# Multi-timeframe support (if implemented)
create_configurable_training_data_config.base_timeframe = '1d'
create_configurable_training_data_config.additional_timeframes = []  # ['1h', '4h'] if implemented