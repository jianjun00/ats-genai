direction_threshold_1d/create_label_config.name = "direction_threshold_1d"
direction_threshold_1d/create_label_config.label_type = "classification"
direction_threshold_1d/create_label_config.parameters = {
    'class_type': 'direction_threshold',
    'column': 'close',
