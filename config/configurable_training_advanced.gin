max_return_5d/create_label_config.parameters = {'return_type': 'max_return', 'column': 'close'}
max_return_5d/create_label_config.lead_periods = 5

min_return_5d/create_label_config.name = "min_return_5d"
min_return_5d/create_label_config.label_type = "return"
min_return_5d/create_label_config.parameters = {'return_type': 'min_return', 'column': 'close'}
min_return_5d/create_label_config.lead_periods = 5

# Volatility prediction
future_volatility/create_label_config.name = "future_volatility_5d"
future_volatility/create_label_config.label_type = "return"
future_volatility/create_label_config.parameters = {'return_type': 'volatility', 'column': 'close'}
