multi_period_return/create_label_config.label_type = "custom"
multi_period_return/create_label_config.parameters = {
    'function_name': 'multi_period_return',
    'periods_list': [1, 3, 5, 10]
}
multi_period_return/create_label_config.lead_periods = 10

drawdown_risk/create_label_config.name = "drawdown_risk_10d"
drawdown_risk/create_label_config.label_type = "custom"
