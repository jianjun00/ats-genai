# Advanced Configurable Training Data Generation
# This configuration demonstrates advanced features including multiple timeframes,
# custom indicators, and sophisticated label generation

# Import necessary modules
import signals.feature_registry
import signals.label_registry
import signals.indicator_factory
import modeling.configurable_train_data_generator

# ===== ADVANCED FEATURE CONFIGURATION =====

# Multiple EMAs with different periods
ema_8/create_feature_config.name = "ema_8"
ema_8/create_feature_config.feature_type = "indicator"
ema_8/create_feature_config.parameters = {'indicator_type': 'ema', 'period': 8}

ema_21/create_feature_config.name = "ema_21"
ema_21/create_feature_config.feature_type = "indicator"
ema_21/create_feature_config.parameters = {'indicator_type': 'ema', 'period': 21}

ema_50/create_feature_config.name = "ema_50"
ema_50/create_feature_config.feature_type = "indicator"
ema_50/create_feature_config.parameters = {'indicator_type': 'ema', 'period': 50}

# ATR for volatility measurement
atr_14/create_feature_config.name = "atr_14"
atr_14/create_feature_config.feature_type = "indicator"
atr_14/create_feature_config.parameters = {'indicator_type': 'atr', 'period': 14}

# MACD indicator
macd/create_feature_config.name = "macd"
macd/create_feature_config.feature_type = "indicator"
macd/create_feature_config.parameters = {
    'indicator_type': 'macd',
    'fast': 12,
    'slow': 26,
    'signal': 9
}

# Bollinger Bands
bollinger/create_feature_config.name = "bollinger"
bollinger/create_feature_config.feature_type = "indicator"
bollinger/create_feature_config.parameters = {
    'indicator_type': 'bollinger',
    'period': 20,
    'std_dev': 2.0
}

# RSI with different periods
rsi_9/create_feature_config.name = "rsi_9"
rsi_9/create_feature_config.feature_type = "indicator"
rsi_9/create_feature_config.parameters = {'indicator_type': 'rsi', 'period': 9}

rsi_21/create_feature_config.name = "rsi_21"
rsi_21/create_feature_config.feature_type = "indicator"
rsi_21/create_feature_config.parameters = {'indicator_type': 'rsi', 'period': 21}

# Lagged price features
price_lag_1/create_feature_config.name = "close_lag_1"
price_lag_1/create_feature_config.feature_type = "transform"
price_lag_1/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
price_lag_1/create_feature_config.lag_periods = 1

price_lag_3/create_feature_config.name = "close_lag_3"
price_lag_3/create_feature_config.feature_type = "transform"
price_lag_3/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
price_lag_3/create_feature_config.lag_periods = 3

price_lag_5/create_feature_config.name = "close_lag_5"
price_lag_5/create_feature_config.feature_type = "transform"
price_lag_5/create_feature_config.parameters = {
    'transform_type': 'pct_change',
    'column': 'close',
    'periods': 1
}
price_lag_5/create_feature_config.lag_periods = 5

# Volume features
volume_sma/create_feature_config.name = "volume_sma_20"
volume_sma/create_feature_config.feature_type = "indicator"
volume_sma/create_feature_config.parameters = {
    'indicator_type': 'sma',
    'period': 20,
    'column': 'volume'
}

volume_ratio/create_feature_config.name = "volume_ratio"
volume_ratio/create_feature_config.feature_type = "transform"
volume_ratio/create_feature_config.parameters = {
    'transform_type': 'volume_ratio',
    'window': 20
}

# Rolling volatility features
volatility_5/create_feature_config.name = "volatility_5d"
volatility_5/create_feature_config.feature_type = "transform"
volatility_5/create_feature_config.parameters = {
    'transform_type': 'volatility',
    'column': 'close',
    'window': 5
}

volatility_30/create_feature_config.name = "volatility_30d"
volatility_30/create_feature_config.feature_type = "transform"
volatility_30/create_feature_config.parameters = {
    'transform_type': 'volatility',
    'column': 'close',
    'window': 30
}

# Log returns with different periods
log_return_1/create_feature_config.name = "log_return_1d"
log_return_1/create_feature_config.feature_type = "transform"
log_return_1/create_feature_config.parameters = {
    'transform_type': 'log_return',
    'column': 'close'
}

# Custom features (if custom functions are registered)
price_velocity/create_feature_config.name = "price_velocity"
price_velocity/create_feature_config.feature_type = "custom"
price_velocity/create_feature_config.parameters = {
    'function_name': 'price_velocity',
    'window': 10
}

# Create advanced feature registry
create_feature_registry.feature_configs = [
    @ema_8/create_feature_config(),
    @ema_21/create_feature_config(),
    @ema_50/create_feature_config(),
    @atr_14/create_feature_config(),
    @macd/create_feature_config(),
    @bollinger/create_feature_config(),
    @rsi_9/create_feature_config(),
    @rsi_21/create_feature_config(),
    @price_lag_1/create_feature_config(),
    @price_lag_3/create_feature_config(),
    @price_lag_5/create_feature_config(),
    @volume_sma/create_feature_config(),
    @volume_ratio/create_feature_config(),
    @volatility_5/create_feature_config(),
    @volatility_30/create_feature_config(),
    @log_return_1/create_feature_config(),
    @price_velocity/create_feature_config()
]

# ===== ADVANCED LABEL CONFIGURATION =====

# Multiple horizon returns
return_1d/create_label_config.name = "return_1d"
return_1d/create_label_config.label_type = "return"
