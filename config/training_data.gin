# Gin configuration for multi-timeframe sequence training data generation

# Import necessary modules
import ml.training_data.timeseries_sequence_training_generator
import state.universe_state_manager
import ml.training_data.dao.training_dataset_dao

# Training Data Configuration
TrainingDataConfig.base_interval_minutes = 1
TrainingDataConfig.training_interval_minutes = 60
TrainingDataConfig.sequence_lengths = {
    '5m': 52,   # Past 52 x 5-minute intervals (4.3 hours)
    '15m': 52,  # Past 52 x 15-minute intervals (13 hours)
    '1h': 24,   # Past 24 x 1-hour intervals (1 day)
    '1d': 20,   # Past 20 x daily intervals (4 weeks)
}
TrainingDataConfig.prediction_horizons = {
    '1h': 6,    # Next 6 hours
    '1d': 5,    # Next 5 days
}
TrainingDataConfig.timeframes = ['1m', '5m', '15m', '1h', '1d', '1w', '1M']
TrainingDataConfig.feature_types = [
    'ohlcv',
    'returns', 
    'volatility',
    'volume_profile',
    'technical',
    'market_structure'
]

# Universe State Manager Configuration
UniverseStateManager.base_path = "data/universe_state"
UniverseStateManager.write_metadata = True

# Technical Indicators Configuration
get_technical_indicators.indicators = ["etop", "ebot", "pldot", "multi_timeframe"]