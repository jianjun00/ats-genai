# Minimal clean gin config for feature extraction
# No includes, no defaults, no fallbacks - explicit configuration only

# Training Data Configuration
domains.services.training_data.timeseries_sequence_training_generator.TrainingDataConfig.base_interval_minutes = 1

# Technical Indicators Signal Names
domains.services.training_data.timeseries_sequence_training_generator.TrainingDataConfig.signal_names = [
    "etop", "ebot", "pldot",
    "envelope_top", "envelope_bot",
    "z1b", "z2b", "z5t", "z6t",
    "sma_20", "ema_12", "rsi_14",
    "macd_line", "macd_signal",
    "bb_upper", "bb_lower", "bb_middle"
]

# Feature Types
domains.services.training_data.timeseries_sequence_training_generator.TrainingDataConfig.feature_types = [
    "ohlcv",
    "returns",
    "volatility",
    "volume_profile",
    "technical",
    "indicators",
    "support_resistance",
    "market_structure"
]

# Universe State Builder - Multi-timeframe processing
domains.trading.services.state.universe_state_builder.UniverseStateIntervalBuilder.target_durations = '5m,15m,60m,1d,1w'
domains.trading.services.state.universe_state_builder.UniverseStateIntervalBuilder.base_duration = '5m'

# Runner Configuration
domains.trading.services.core.app.runner.Runner.base_duration = '5m'

# Note: IndicatorBuilder will auto-create indicators from signal_names when instantiated without config