# Integration Environment Configuration
# Extends base.gin with integration-specific overrides

include 'config/base.gin'

# === Environment ===
bind = ['env_type', 'intg']

# === Logging ===
LoggingConfig.log_level = 'INFO'
LoggingConfig.json_logs = True  # Structured logs for monitoring

# === Database (TimescaleDB) ===
bind = ['database.host', 'localhost']
bind = ['database.port', 4432]
bind = ['database.user', 'postgres']
bind = ['database.password', 'intg_password']
bind = ['database.database', 'intg_db']
bind = ['database.pool_max_size', 15]
bind = ['database.connection_timeout', 20]

# === Feature Flags ===
bind = ['strict_validation', True]
bind = ['enable_metrics', True]  # Enable monitoring
bind = ['enable_caching', True]

# === API Configuration ===
bind = ['api.timeout', 60]  # Longer timeouts for integration
bind = ['api.retry_attempts', 5]

# === File Storage ===
bind = ['storage.base_path', '/mnt/d/ats-data']
bind = ['storage.backup_path', '/mnt/d/ats-backup']
bind = ['storage.log_path', '/mnt/d/ats-logs']

# === Integration Testing ===
bind = ['run_validation_tests', True]
bind = ['validate_data_quality', True]
bind = ['enable_monitoring', True]