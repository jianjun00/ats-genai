import app.indicator_runner
import core.config.environment
import core.config.database
import core.config.logging_config
import domains.trading.signals.indicator

# Configure the environment for Docker
# Define macros for environment types
DOCKER = "DOCKER"

# Configure database parameters
core.config.database.Database.host = 'timescaledb'
core.config.database.Database.port = 5432
core.config.database.Database.user = 'postgres'
core.config.database.Database.password = 'REPLACE_WITH_ACTUAL_DB_PASSWORD'
core.config.database.Database.database = 'trading_db'
core.config.database.Database.base_database = 'trading_db'
core.config.database.Database.pool_min_size = 1
core.config.database.Database.pool_max_size = 10
core.config.database.Database.command_timeout = 60

# Configure environment
core.config.environment.Environment.env_type = %DOCKER
core.config.environment.Environment.logging_config = @core.config.logging_config.LoggingConfig()
core.config.logging_config.LoggingConfig.log_level = "DEBUG"
core.config.logging_config.LoggingConfig.log_format = "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

