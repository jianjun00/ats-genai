quandl_api_key = 'test_quandl_key'
fmp_api_key = 'test_fmp_key'
polygon_api_key = 'test_polygon_key'
tiingo_api_key = 'test_tiingo_key'

# Logging Configuration

# Features
bind = ['enable_caching', False]
bind = ['enable_metrics', False]
bind = ['strict_validation', True]

import app.indicator_runner
import config.environment
import signals.indicator

# Configure the environment for Docker
# Define macros for environment types
DOCKER = "DOCKER"

# Configure database parameters
config.database.Database.host = 'timescaledb'
config.database.Database.port = 5432
config.database.Database.user = 'postgres'
config.database.Database.password = 'postgres'
config.database.Database.database = 'trading_db'
config.database.Database.base_database = 'trading_db'
config.database.Database.pool_min_size = 1
config.database.Database.pool_max_size = 10
config.database.Database.command_timeout = 60

# Configure environment
config.environment.Environment.env_type = %DOCKER
config.environment.Environment.logging_config = @config.logging_config.LoggingConfig()
config.logging_config.LoggingConfig.log_level = "DEBUG"
config.logging_config.LoggingConfig.log_format = "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

