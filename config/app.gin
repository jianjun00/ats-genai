# Gin config for market-forecast-app (test environment example)
bind = ['env_type', 'test']

# API keys
finnhub_api_key = 'REPLACE_WITH_ACTUAL_FINNHUB_API_KEY'
iex_api_key = 'REPLACE_WITH_ACTUAL_IEX_API_KEY'
quandl_api_key = 'REPLACE_WITH_ACTUAL_QUANDL_API_KEY'
fmp_api_key = 'REPLACE_WITH_ACTUAL_FMP_API_KEY'
polygon_api_key = 'REPLACE_WITH_ACTUAL_POLYGON_API_KEY'
tiingo_api_key = 'REPLACE_WITH_ACTUAL_TIINGO_API_KEY'

# Logging
LoggingConfig.log_level = 'INFO'
LoggingConfig.log_format = '%(asctime)s - %(name)s - %(levelname)s - %(message)s'

# Features
bind = ['enable_caching', False]
bind = ['enable_metrics', False]
bind = ['strict_validation', True]

# Durations for UniverseStateBuilder
# state.universe_state_builder.UniverseStateBuilder.base_duration = '5m'
# state.universe_state_builder.UniverseStateBuilder.target_durations = '5m,15m,60m'

# Runner
# app.runner.Runner.base_duration = '5m'
# app.runner.Runner.callbacks = ["state.universe_state_builder.UniverseStateBuilder"]
# state.universe_state_manager.UniverseStateManager.base_path = '/tmp/universe_states'

# universe.universe_manager.UniverseManager.universe_id = 1

# Database
config.database.Database.host = 'localhost'
config.database.Database.port = 5432
config.database.Database.user = 'postgres'
config.database.Database.password = 'REPLACE_WITH_ACTUAL_DB_PASSWORD'
config.database.Database.database = 'test_db'
config.database.Database.base_database = 'test_db'
config.database.Database.pool_min_size = 1
config.database.Database.pool_max_size = 10
config.database.Database.command_timeout = 60
bind = ['DatabaseTestManager.database_name', 'test_db']
