# Gin config for market-forecast-app (test environment example)
bind = ['env_type', 'test']

# API keys
finnhub_api_key = 'test_finnhub_key'
iex_api_key = 'test_iex_key'
quandl_api_key = 'test_quandl_key'
fmp_api_key = 'test_fmp_key'
polygon_api_key = 'test_polygon_key'
tiingo_api_key = 'test_tiingo_key'

# Logging
LoggingConfig.level = 'INFO'
LoggingConfig.format = '%(asctime)s - %(name)s - %(levelname)s - %(message)s'

# Features
bind = ['enable_caching', False]
bind = ['enable_metrics', False]
bind = ['strict_validation', True]

# Runner
bind = ['callbacks', 'state.universe_state_builder.UniverseStateBuilder']
bind = ['saved_dir', '/tmp/universe_states']

# Database
Database.host = 'localhost'
Database.port = 5432
Database.user = 'postgres'
Database.password = 'password'
Database.database = 'test_db'
Database.base_database = 'test_db'
Database.pool_min_size = 1
Database.pool_max_size = 10
Database.command_timeout = 60
bind = ['TestDatabaseManager.database_name', 'test_db']
