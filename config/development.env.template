# Development Environment Configuration Template
# Copy this file to development.env and update with actual values

# Database Configuration
DB_HOST=ats-dev-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=dev_password
DB_NAME=dev_db

# Agent Configuration
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=DEBUG
AGENT_MONITORING_INTERVAL=60  # 1 minute for faster testing
AGENT_MAX_CONCURRENT_WORKFLOWS=5

# API Keys (Use test keys for development)
POLYGON_API_KEY=your_dev_polygon_key
TIINGO_API_KEY=your_dev_tiingo_key
EODHD_API_KEY=your_dev_eodhd_key

# Alert Notification Configuration (Disabled by default in dev)
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SLACK_NOTIFICATIONS=false
EMAIL_SMTP_SERVER=localhost
EMAIL_SMTP_PORT=1025  # Use local SMTP server for testing
EMAIL_RECIPIENTS=dev-team@localhost

# Slack Integration (Use test webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TEST/WEBHOOK/URL

# System Monitoring Thresholds (More lenient for dev)
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=90
MEMORY_WARNING_THRESHOLD=85
MEMORY_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=90
DISK_CRITICAL_THRESHOLD=98

# Performance Configuration
MAX_NOTIFICATIONS_PER_HOUR=50
ALERT_COOLDOWN_MINUTES=10
STALL_THRESHOLD_MINUTES=30

# Logging Configuration
LOG_RETENTION_DAYS=7
STRUCTURED_LOGGING=true
LOG_LEVEL=DEBUG

# Security Configuration
ENABLE_API_AUTH=false  # Disabled for development
API_SECRET_KEY=dev_secret_key

# Backup Configuration
BACKUP_ENABLED=false  # Disabled for development
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7