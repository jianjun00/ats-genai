# Production Environment Configuration Template
# Copy this file to production.env and update with actual values

# Database Configuration
DB_HOST=ats-prod-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=prod_secure_password_2024
DB_NAME=prod_db

# Agent Configuration
AGENT_ENVIRONMENT=production
AGENT_LOG_LEVEL=INFO
AGENT_MONITORING_INTERVAL=300  # 5 minutes
AGENT_MAX_CONCURRENT_WORKFLOWS=20

# API Keys (Required for data collection)
POLYGON_API_KEY=wfrcZNX3ZJJt55Or_CmBXda8G8e8tABD
TIINGO_API_KEY=5f40b4f36e171405746304ec0e5a6f3aa9ca77e5
EODHD_API_KEY=68aa0c7d2fe831.67386369

# Alert Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=true
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=ats-alerts@example.com
EMAIL_SMTP_PASSWORD=demo_email_password
EMAIL_RECIPIENTS=admin@ats-genai.com,ops@ats-genai.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T123ABC/B456DEF/demo_webhook_url
SLACK_CHANNEL=#data-quality-alerts

# System Monitoring Thresholds
CPU_WARNING_THRESHOLD=70
CPU_CRITICAL_THRESHOLD=85
MEMORY_WARNING_THRESHOLD=80
MEMORY_CRITICAL_THRESHOLD=90
DISK_WARNING_THRESHOLD=85
DISK_CRITICAL_THRESHOLD=95

# Performance Configuration
MAX_NOTIFICATIONS_PER_HOUR=20
ALERT_COOLDOWN_MINUTES=30
STALL_THRESHOLD_MINUTES=60

# Logging Configuration
LOG_RETENTION_DAYS=30
STRUCTURED_LOGGING=true
LOG_LEVEL=INFO

# Security Configuration
ENABLE_API_AUTH=false  # Set to true for production
API_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30