# Test Dockerfile for simple FastAPI app
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Copy only what's needed for the test
COPY test_app.py .

# Install uvicorn and fastapi using pip
RUN pip install --no-cache-dir uvicorn fastapi

# Run the test app
CMD ["uvicorn", "test_app:app", "--host", "0.0.0.0", "--port", "8080"]
