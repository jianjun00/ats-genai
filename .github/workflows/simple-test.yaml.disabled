name: Simple Test

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: password
          POSTGRES_USER: postgres
          POSTGRES_DB: postgres
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
    - uses: actions/checkout@v4
    
    - name: Install uv
      uses: astral-sh/setup-uv@v3
      with:
        version: "latest"
    
    - name: Set up Python
      run: uv python install 3.11
    
    - name: Install minimal dependencies
      run: |
        echo "Installing minimal dependencies..."
        uv pip install pytest asyncpg aiofiles
        echo "Minimal dependencies installed"
    
    - name: Create test database
      run: |
        sleep 5
        PGPASSWORD=password psql -h localhost -U postgres -d postgres -c "
          CREATE USER testuser WITH PASSWORD 'testpass' SUPERUSER;
          CREATE DATABASE testdb OWNER testuser;
        "
        echo "Test database setup completed"
        
    - name: Test database connection
      run: |
        echo "Testing database connection..."
        python3 -c "
import asyncio
import asyncpg

async def test_connection():
    try:
        conn = await asyncpg.connect('postgresql://testuser:testpass@localhost:5432/testdb')
        result = await conn.fetchval('SELECT 1')
        print(f'✅ Database connection successful: {result}')
        await conn.close()
        return True
    except Exception as e:
        print(f'❌ Database connection failed: {e}')
        return False

if not asyncio.run(test_connection()):
    exit(1)
"
        echo "✅ Database connection test passed"

    - name: Run basic tests
      env:
        PYTHONPATH: src
        DATABASE_URL: postgresql://testuser:testpass@localhost:5432/testdb
      run: |
        echo "Running basic tests..."
        python3 -c "
import os
print('Environment variables:')
print(f'PYTHONPATH: {os.environ.get(\"PYTHONPATH\", \"Not set\")}')
print(f'DATABASE_URL: {os.environ.get(\"DATABASE_URL\", \"Not set\")}')
print('✅ Environment test passed')
"
        echo "✅ All tests passed"