name: ATS Integration Deployment

on:
  push:
    branches: [main]
    paths:
      - 'src/**'
      - 'scripts/**'
      - 'tests/**'
      - 'requirements.txt'
      - 'pyproject.toml'
      - 'Dockerfile*'
  pull_request:
    branches: [main]
    paths:
      - 'src/**'
      - 'scripts/**'
      - 'tests/**'
      - 'requirements.txt'
      - 'pyproject.toml'
      - 'Dockerfile*'
  workflow_dispatch:
    inputs:
      skip_tests:
        description: 'Skip unit tests'
        required: false
        default: false
        type: boolean
      force_deploy:
        description: 'Force deployment to integration'
        required: false
        default: false
        type: boolean

env:
  REGISTRY: docker.io
  IMAGE_NAME: dragonflyer762/ats-genai
  PYTHON_VERSION: "3.11"

jobs:
  # Unit Tests - Must pass for deployment
  unit-tests:
    if: github.event.inputs.skip_tests != 'true'
    runs-on: ubuntu-latest
    
    services:
      postgres:
        image: postgres:13
        env:
          POSTGRES_PASSWORD: test_password
          POSTGRES_USER: postgres
          POSTGRES_DB: test_db
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: ${{ env.PYTHON_VERSION }}
    
    - name: Install uv
      run: curl -LsSf https://astral.sh/uv/install.sh | sh
    
    - name: Install dependencies
      run: |
        source $HOME/.cargo/env
        uv sync
    
    - name: Run schema validation
      run: |
        source $HOME/.cargo/env
        PYTHONPATH=src uv run python src/validation/validate_schema.py --check-all
    
    - name: Run unit tests
      env:
        DB_HOST: localhost
        DB_PORT: 5432
        DB_USER: postgres
        DB_PASSWORD: test_password
        DB_NAME: test_db
        PYTHONPATH: src
      run: |
        source $HOME/.cargo/env
        # Run core unit tests
        uv run pytest tests/unit/ -v --tb=short --maxfail=5
        uv run pytest tests/core/ tests/config/ tests/calendars/ -v --tb=short --maxfail=3
        
        # Run critical integration tests
        uv run pytest tests/integration/test_analytics_platform_integration.py -v --tb=short
    
    - name: Upload test results
      uses: actions/upload-artifact@v3
      if: always()
      with:
        name: test-results
        path: |
          test-results.xml
          coverage.xml

  # Build Docker Image
  build-image:
    needs: unit-tests
    if: always() && (needs.unit-tests.result == 'success' || github.event.inputs.skip_tests == 'true' || github.event.inputs.force_deploy == 'true')
    runs-on: ubuntu-latest
    outputs:
      image-tag: ${{ steps.meta.outputs.tags }}
      image-digest: ${{ steps.build.outputs.digest }}
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up Docker Buildx
      uses: docker/setup-buildx-action@v3
    
    - name: Log in to Docker Hub
      uses: docker/login-action@v3
      with:
        registry: ${{ env.REGISTRY }}
        username: ${{ secrets.DOCKERHUB_USERNAME }}
        password: ${{ secrets.DOCKERHUB_TOKEN }}
    
    - name: Extract metadata
      id: meta
      uses: docker/metadata-action@v5
      with:
        images: ${{ env.IMAGE_NAME }}
        tags: |
          type=ref,event=branch
          type=ref,event=pr
          type=sha,prefix={{branch}}-
          type=raw,value=intg-latest,enable={{is_default_branch}}
    
    - name: Build and push Docker image
      id: build
      uses: docker/build-push-action@v5
      with:
        context: .
        platforms: linux/amd64
        push: true
        tags: ${{ steps.meta.outputs.tags }}
        labels: ${{ steps.meta.outputs.labels }}
        cache-from: type=gha
        cache-to: type=gha,mode=max

  # Deploy to Integration Environment
  deploy-to-integration:
    needs: [unit-tests, build-image]
    if: always() && github.ref == 'refs/heads/main' && (needs.unit-tests.result == 'success' || github.event.inputs.skip_tests == 'true') && needs.build-image.result == 'success'
    runs-on: ubuntu-latest
    environment: integration
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up SSH connection to integration server
      uses: webfactory/ssh-agent@v0.8.0
      with:
        ssh-private-key: ${{ secrets.INTEGRATION_SSH_KEY }}
    
    - name: Deploy to Integration Environment
      run: |
        echo "🚀 Deploying to ATS Integration Environment"
        
        # SSH connection details
        INTEGRATION_HOST="${{ secrets.INTEGRATION_HOST }}"
        INTEGRATION_USER="${{ secrets.INTEGRATION_USER }}"
        IMAGE_TAG="${{ needs.build-image.outputs.image-tag }}"
        
        # Deploy commands via SSH
        ssh -o StrictHostKeyChecking=no ${INTEGRATION_USER}@${INTEGRATION_HOST} << 'EOF'
          set -e
          
          echo "📦 Pulling latest Docker image..."
          docker pull ${{ env.IMAGE_NAME }}:intg-latest
          
          echo "🛑 Stopping existing integration services..."
          python3 scripts/run_intg.py stop --service analytics || true
          python3 scripts/run_intg.py stop --service api || true
          
          echo "🔄 Running database migrations..."
          docker run --rm --network host \
            -v $(pwd):/workspace \
            -e PYTHONPATH=/workspace/src \
            -e DB_HOST=localhost \
            -e DB_PORT=5433 \
            -e DB_USER=postgres \
            -e DB_PASSWORD=intg_password \
            -e DB_NAME=intg_db \
            ${{ env.IMAGE_NAME }}:intg-latest \
            python /workspace/scripts/run_intg_migrations.py
          
          echo "🚀 Starting integration services with new image..."
          python3 scripts/run_intg.py start --service analytics
          python3 scripts/run_intg.py start --service api
          
          echo "⏳ Waiting for services to be ready..."
          sleep 30
          
          echo "🔍 Health checks..."
          python3 scripts/run_intg.py query --query "SELECT version()"
          python3 scripts/run_intg.py status
          
          # Test external access
          curl -f http://localhost:3002/health || echo "⚠️ Analytics service health check failed"
          curl -f http://localhost:8001/health || echo "⚠️ API service health check failed"
          
          echo "✅ Integration deployment completed successfully"
        EOF
    
    - name: Update deployment status
      run: |
        echo "📊 Integration Deployment Summary:"
        echo "🎯 Environment: integration"
        echo "📦 Image: ${{ needs.build-image.outputs.image-tag }}"
        echo "🔗 Digest: ${{ needs.build-image.outputs.image-digest }}"
        echo "⏰ Deployed at: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"

  # Integration Tests (Post-Deployment)
  integration-tests:
    needs: [deploy-to-integration]
    if: always() && needs.deploy-to-integration.result == 'success'
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: ${{ env.PYTHON_VERSION }}
    
    - name: Install dependencies
      run: |
        curl -LsSf https://astral.sh/uv/install.sh | sh
        source $HOME/.cargo/env
        uv sync
    
    - name: Run integration tests against live environment
      env:
        INTEGRATION_HOST: ${{ secrets.INTEGRATION_HOST }}
        INTEGRATION_API_URL: http://${{ secrets.INTEGRATION_HOST }}:8001
        INTEGRATION_ANALYTICS_URL: http://${{ secrets.INTEGRATION_HOST }}:3002
      run: |
        source $HOME/.cargo/env
        
        echo "🧪 Running integration tests against live environment..."
        
        # Test API connectivity
        curl -f ${INTEGRATION_API_URL}/health
        curl -f ${INTEGRATION_ANALYTICS_URL}/health
        
        # Run integration test suite
        PYTHONPATH=src uv run pytest tests/integration/test_live_environment.py -v --tb=short || true
        
        echo "✅ Integration tests completed"

  # Notification
  notify:
    needs: [unit-tests, build-image, deploy-to-integration, integration-tests]
    if: always()
    runs-on: ubuntu-latest
    
    steps:
    - name: Send deployment notification
      run: |
        if [[ "${{ needs.deploy-to-integration.result }}" == "success" ]]; then
          STATUS="✅ SUCCESS"
          MESSAGE="ATS Integration deployment completed successfully"
          COLOR="good"
        else
          STATUS="❌ FAILED"
          MESSAGE="ATS Integration deployment failed"
          COLOR="danger"
        fi
        
        echo "📢 ${STATUS}: ${MESSAGE}"
        echo "🧪 Unit Tests: ${{ needs.unit-tests.result }}"
        echo "📦 Build: ${{ needs.build-image.result }}"
        echo "🚀 Deploy: ${{ needs.deploy-to-integration.result }}"
        echo "🔍 Integration Tests: ${{ needs.integration-tests.result }}"
        
        # Add Slack notification if webhook is configured
        if [[ -n "${{ secrets.SLACK_WEBHOOK_URL }}" ]]; then
          curl -X POST -H 'Content-type: application/json' \
            --data "{\"text\":\"${STATUS}: ATS Integration Deployment\\n📦 Image: ${{ needs.build-image.outputs.image-tag }}\\n🔗 Workflow: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\"}" \
            ${{ secrets.SLACK_WEBHOOK_URL }}
        fi