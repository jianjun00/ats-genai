name: Ultra Simple Test

on:
  push:
    branches: [ main ]

jobs:
  simple:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'
    
    - name: Test basic functionality
      run: |
        echo "🧪 Ultra simple test starting..."
        python3 --version
        echo "✅ Python is working"
        
        echo "Testing pip installation..."
        pip install asyncpg --quiet
        echo "✅ Can install packages"
        
        echo "Testing Python imports..."
        python3 -c "import asyncpg; print('✅ asyncpg import works')"
        python3 -c "print('✅ Python execution works')"
        
        echo "Testing basic async functionality..."
        python3 -c "import asyncio; asyncio.run(asyncio.sleep(0.1)); print('✅ Async functionality works')"
        
        echo "🎉 ULTRA SIMPLE TEST PASSED! 🎉"
        echo "Test completed at $(date)"