name: ATS CI/CD Pipeline (Improved)

on:
  push:
    branches: [main, develop, feature/*]
    paths:
      - 'services/**'
      - 'src/**'
      - 'k8s/**'
      - 'Dockerfile*'
      - 'requirements.txt'
      - 'pyproject.toml'
      - 'pytest.ini'
      - '.github/workflows/**'
  pull_request:
    branches: [main, develop]
    paths:
      - 'services/**'
      - 'src/**'
      - 'k8s/**'
      - 'Dockerfile*'
      - 'requirements.txt'
      - 'pyproject.toml'
      - 'pytest.ini'
      - '.github/workflows/**'
  schedule:
    # Weekly deployment to integration environment (Mondays at 9 AM UTC)
    - cron: '0 9 * * 1'
    # Monthly deployment to production environment (First Monday of month at 10 AM UTC)
    - cron: '0 10 1-7 * 1'
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: true
        default: 'dev'
        type: choice
        options:
        - dev
        - intg
        - prod
      skip_tests:
        description: 'Skip tests (emergency deployment)'
        required: false
        default: false
        type: boolean
      force_deploy:
        description: 'Force deployment regardless of schedule'
        required: false
        default: false
        type: boolean

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  PYTHON_VERSION: "3.12"
  NODE_VERSION: "20"

jobs:
  # Job 1: Determine Deployment Strategy and Environment
  deployment-strategy:
    runs-on: ubuntu-latest
    outputs:
      should-deploy: ${{ steps.strategy.outputs.should-deploy }}
      target-env: ${{ steps.strategy.outputs.target-env }}
      deployment-type: ${{ steps.strategy.outputs.deployment-type }}
    
    steps:
    - name: Determine deployment strategy
      id: strategy
      run: |
        echo "🎯 Determining deployment strategy..."
        
        # Default values
        SHOULD_DEPLOY="true"
        TARGET_ENV="dev"
        DEPLOYMENT_TYPE="push"
        
        # Handle scheduled deployments
        if [ "${{ github.event_name }}" = "schedule" ]; then
          # Check which scheduled job triggered this
          case "${{ github.event.schedule }}" in
            "0 9 * * 1")  # Weekly integration deployment
              TARGET_ENV="intg"
              DEPLOYMENT_TYPE="scheduled-weekly"
              echo "📅 Weekly integration deployment triggered"
              ;;
            "0 10 1-7 * 1")  # Monthly production deployment
              TARGET_ENV="prod"
              DEPLOYMENT_TYPE="scheduled-monthly"
              echo "📅 Monthly production deployment triggered"
              ;;
          esac
        fi
        
        # Handle manual workflow dispatch
        if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
          TARGET_ENV="${{ github.event.inputs.environment }}"
          DEPLOYMENT_TYPE="manual"
          echo "🎮 Manual deployment to $TARGET_ENV requested"
        fi
        
        # Handle branch-based automatic deployments
        if [ "${{ github.event_name }}" = "push" ]; then
          case "${{ github.ref_name }}" in
            "main")
              TARGET_ENV="dev"
              DEPLOYMENT_TYPE="push-main"
              ;;
            "develop")
              TARGET_ENV="intg"
              DEPLOYMENT_TYPE="push-develop"
              ;;
            feature/*)
              SHOULD_DEPLOY="false"
              echo "🚫 Skipping deployment for feature branch"
              ;;
          esac
        fi
        
        # Handle pull requests (no deployment)
        if [ "${{ github.event_name }}" = "pull_request" ]; then
          SHOULD_DEPLOY="false"
          echo "🔍 Pull request - running tests only"
        fi
        
        echo "should-deploy=$SHOULD_DEPLOY" >> $GITHUB_OUTPUT
        echo "target-env=$TARGET_ENV" >> $GITHUB_OUTPUT
        echo "deployment-type=$DEPLOYMENT_TYPE" >> $GITHUB_OUTPUT
        echo "📋 Strategy: deploy=$SHOULD_DEPLOY, env=$TARGET_ENV, type=$DEPLOYMENT_TYPE"

  # Job 2: Pre-flight Checks and Environment Setup
  preflight:
    runs-on: ubuntu-latest
    needs: deployment-strategy
    if: needs.deployment-strategy.outputs.should-deploy == 'true'
    outputs:
      services: ${{ steps.discover.outputs.services }}
      version: ${{ steps.version.outputs.version }}
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    - name: Environment preflight checks
      id: check
      run: |
        echo "🔍 Running preflight checks for ${{ needs.deployment-strategy.outputs.target-env }}..."
        
        # Determine target environment
        if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
          TARGET_ENV="${{ github.event.inputs.environment }}"
        elif [[ "${{ github.ref }}" == "refs/heads/main" ]]; then
          TARGET_ENV="production"
        elif [[ "${{ github.ref }}" == "refs/heads/develop" ]]; then
          TARGET_ENV="staging"
        else
          TARGET_ENV="dev"
        fi
        
        echo "target-env=${TARGET_ENV}" >> $GITHUB_OUTPUT
        
        # Determine if we should deploy
        SHOULD_DEPLOY="false"
        if [[ "${{ github.event_name }}" == "push" && ("${{ github.ref }}" == "refs/heads/main" || "${{ github.ref }}" == "refs/heads/develop") ]]; then
          SHOULD_DEPLOY="true"
        elif [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
          SHOULD_DEPLOY="true"
        fi
        
        echo "should-deploy=${SHOULD_DEPLOY}" >> $GITHUB_OUTPUT
        
        echo "✅ Target Environment: ${TARGET_ENV}"
        echo "✅ Should Deploy: ${SHOULD_DEPLOY}"
    
    - name: Discover services
      id: discover
      run: |
        echo "🔍 Discovering services..."
        SERVICES=$(find services/ -type d -maxdepth 1 -mindepth 1 -exec basename {} \; | jq -R . | jq -s . | jq -c .)
        echo "services=${SERVICES}" >> $GITHUB_OUTPUT
        echo "✅ Found services: ${SERVICES}"
    
    - name: Generate version
      id: version
      run: |
        # Generate semantic version based on git
        if git describe --tags --exact-match HEAD 2>/dev/null; then
          VERSION=$(git describe --tags --exact-match HEAD)
        else
          VERSION="${{ github.ref_name }}-$(git rev-parse --short HEAD)-$(date +%Y%m%d%H%M%S)"
        fi
        echo "version=${VERSION}" >> $GITHUB_OUTPUT
        echo "✅ Generated version: ${VERSION}"

  # Job 2: Unified Testing (Much More Reliable)
  test:
    runs-on: ubuntu-latest
    needs: [deployment-strategy, preflight]
    if: ${{ github.event.inputs.skip_tests != 'true' && needs.deployment-strategy.outputs.should-deploy == 'true' }}
    
    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_PASSWORD: test_password
          POSTGRES_USER: test_user
          POSTGRES_DB: test_db
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 10
        ports:
          - 5432:5432
      
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 6379:6379
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: ${{ env.PYTHON_VERSION }}
        cache: 'pip'
    
    - name: Install system dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y postgresql-client redis-tools
    
    - name: Install Python dependencies with retry
      run: |
        for i in {1..3}; do
          python -m pip install --upgrade pip && \
          pip install -r requirements.txt && \
          pip install pytest pytest-cov pytest-asyncio black flake8 mypy safety bandit ruff && \
          break || sleep 10
        done
    
    - name: Wait for services to be ready
      run: |
        echo "⏳ Waiting for services to be ready..."
        # Wait for PostgreSQL
        for i in {1..30}; do
          if pg_isready -h localhost -p 5432 -U test_user; then
            echo "✅ PostgreSQL ready"
            break
          fi
          echo "Waiting for PostgreSQL... (${i}/30)"
          sleep 2
        done
        
        # Wait for Redis
        for i in {1..30}; do
          if redis-cli -h localhost -p 6379 ping | grep -q PONG; then
            echo "✅ Redis ready"
            break
          fi
          echo "Waiting for Redis... (${i}/30)"
          sleep 2
        done
        
        # Test database connection
        PGPASSWORD=test_password psql -h localhost -U test_user -d test_db -c "SELECT 1;" || exit 1
    
    - name: Code quality checks
      run: |
        echo "🔍 Running code quality checks..."
        
        # Format check
        echo "📝 Checking code formatting..."
        black --check --diff src/ services/ || (echo "❌ Code formatting failed. Run 'black src/ services/' to fix." && exit 1)
        
        # Linting with ruff (faster than flake8)
        echo "🔍 Running linting..."
        ruff check src/ services/ --output-format=github || true
        
        # Type checking
        echo "🔍 Running type checking..."
        mypy src/ --ignore-missing-imports --show-error-codes || true
    
    - name: Security scanning
      run: |
        echo "🔒 Running security scans..."
        
        # Dependency scanning
        safety check --json --output security-deps.json || true
        
        # Code security scanning
        bandit -r src/ services/ -f json -o security-code.json || true
        
        echo "✅ Security scans completed"
    
    - name: Unit tests
      env:
        PYTHONPATH: ${{ github.workspace }}/src
        ENVIRONMENT: test
        DATABASE_URL: postgresql://test_user:test_password@localhost:5432/test_db
      run: |
        echo "🧪 Running unit tests..."
        pytest tests/ \
          -v \
          --tb=short \
          --cov=src \
          --cov=services \
          --cov-report=xml \
          --cov-report=term-missing \
          --cov-fail-under=70 \
          --maxfail=10 \
          --durations=10
    
    - name: Integration tests
      env:
        PYTHONPATH: ${{ github.workspace }}/src
        ENVIRONMENT: test
        DATABASE_URL: postgresql://test_user:test_password@localhost:5432/test_db
        REDIS_URL: redis://localhost:6379
      run: |
        echo "🧪 Running integration tests..."
        if [ -d "tests/integration" ]; then
          pytest tests/integration/ \
            -v \
            --tb=short \
            --maxfail=5 \
            --durations=10 \
            || echo "⚠️ Integration tests had failures"
        else
          echo "ℹ️ No integration tests found"
        fi
    
    - name: Upload test results
      if: always()
      uses: actions/upload-artifact@v4
      with:
        name: test-results-${{ github.run_id }}
        path: |
          coverage.xml
          security-*.json
        retention-days: 30
    
    - name: Upload coverage to Codecov
      if: always()
      uses: codecov/codecov-action@v4
      with:
        file: ./coverage.xml
        fail_ci_if_error: false
        verbose: true

  # Job 3: Build and Push (Simplified and More Reliable)
  build:
    runs-on: ubuntu-latest
    needs: [deployment-strategy, preflight, test]
    if: always() && (success() || github.event.inputs.skip_tests == 'true') && needs.deployment-strategy.outputs.should-deploy == 'true'
    
    strategy:
      fail-fast: false
      matrix:
        service: ${{ fromJson(needs.preflight.outputs.services) }}
    
    outputs:
      images: ${{ steps.collect.outputs.images }}
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up Docker Buildx
      uses: docker/setup-buildx-action@v3
    
    - name: Log in to Container Registry
      uses: docker/login-action@v3
      with:
        registry: ${{ env.REGISTRY }}
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}
    
    - name: Extract metadata
      id: meta
      uses: docker/metadata-action@v5
      with:
        images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}-${{ matrix.service }}
        tags: |
          type=ref,event=branch
          type=ref,event=pr
          type=sha,prefix={{branch}}-
          type=raw,value=latest,enable={{is_default_branch}}
          type=raw,value=${{ needs.preflight.outputs.version }}
        labels: |
          org.opencontainers.image.title=ATS ${{ matrix.service }}
          org.opencontainers.image.description=ATS ${{ matrix.service }} - Automated Trading System
          org.opencontainers.image.vendor=ATS Team
          org.opencontainers.image.version=${{ needs.preflight.outputs.version }}
    
    - name: Build and push Docker image
      uses: docker/build-push-action@v5
      with:
        context: .
        file: services/${{ matrix.service }}/Dockerfile
        platforms: linux/amd64
        push: true
        tags: ${{ steps.meta.outputs.tags }}
        labels: ${{ steps.meta.outputs.labels }}
        cache-from: type=gha
        cache-to: type=gha,mode=max
        build-args: |
          SERVICE_NAME=${{ matrix.service }}
          BUILD_DATE=${{ steps.meta.outputs.json.date }}
          VCS_REF=${{ github.sha }}
          VERSION=${{ needs.preflight.outputs.version }}
    
    - name: Scan image for vulnerabilities
      uses: docker/scout-action@v1
      with:
        command: cves
        image: ${{ steps.meta.outputs.tags }}
        only-severities: critical,high
        exit-code: false
    
    - name: Collect image information
      id: collect
      run: |
        echo "service=${{ matrix.service }}" >> $GITHUB_OUTPUT
        echo "image=${{ steps.meta.outputs.tags }}" >> $GITHUB_OUTPUT

  # Job 4: Deploy to Kubernetes (Improved Argo CD Integration)
  deploy:
    runs-on: ubuntu-latest
    needs: [deployment-strategy, preflight, test, build]
    if: always() && (success() || github.event.inputs.skip_tests == 'true') && needs.deployment-strategy.outputs.should-deploy == 'true'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        token: ${{ secrets.GITOPS_TOKEN || secrets.GITHUB_TOKEN }}
        fetch-depth: 0
    
    - name: Install tools
      run: |
        # Install yq
        sudo wget -qO /usr/local/bin/yq https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64
        sudo chmod +x /usr/local/bin/yq
        
        # Install kubectl
        curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
        sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
    
    - name: Update Kubernetes manifests
      run: |
        echo "🚀 Updating Kubernetes manifests..."
        
        # Get target environment
        TARGET_ENV="${{ needs.preflight.outputs.target-env }}"
        VERSION="${{ needs.preflight.outputs.version }}"
        TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        
        echo "Environment: ${TARGET_ENV}"
        echo "Version: ${VERSION}"
        
        # Update image tags for each service
        for service_dir in k8s/*/; do
          service=$(basename "$service_dir")
          deployment_file="${service_dir}deployment.yaml"
          
          if [[ -f "$deployment_file" && "$service" =~ ^(minute-service|eod-service|analytics-service)$ ]]; then
            echo "Updating ${service}..."
            
            # Update image tag
            NEW_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}-${service}:${{ github.ref_name }}-${{ github.sha }}"
            
            # Use yq to update the image
            yq eval "(.spec.template.spec.containers[] | select(.name == \"${service}\") | .image) = \"${NEW_IMAGE}\"" -i "$deployment_file"
            
            # Update deployment annotation for rolling restart
            yq eval ".spec.template.metadata.annotations[\"deployment.kubernetes.io/restartedAt\"] = \"${TIMESTAMP}\"" -i "$deployment_file"
            yq eval ".spec.template.metadata.annotations[\"deployment.kubernetes.io/version\"] = \"${VERSION}\"" -i "$deployment_file"
            
            echo "✅ Updated ${service}: ${NEW_IMAGE}"
          fi
        done
    
    - name: Validate Kubernetes manifests
      run: |
        echo "🔍 Validating Kubernetes manifests..."
        
        # Install kubeval
        wget https://github.com/instrumenta/kubeval/releases/latest/download/kubeval-linux-amd64.tar.gz
        tar xf kubeval-linux-amd64.tar.gz
        sudo mv kubeval /usr/local/bin
        
        # Validate manifests
        find k8s/ -name "*.yaml" -type f | while read -r file; do
          echo "Validating $file..."
          kubeval "$file" || echo "⚠️ Validation warning for $file"
        done
        
        echo "✅ Manifest validation completed"
    
    - name: Create deployment commit
      if: ${{ secrets.GITOPS_TOKEN }}
      run: |
        git config --global user.name "github-actions[bot]"
        git config --global user.email "github-actions[bot]@users.noreply.github.com"
        
        git add k8s/
        
        if git diff --staged --quiet; then
          echo "ℹ️ No changes to commit"
        else
          git commit -m "🚀 Deploy ATS services v${{ needs.preflight.outputs.version }}
          
          Environment: ${{ needs.preflight.outputs.target-env }}
          Commit: ${{ github.sha }}
          Triggered by: ${{ github.actor }}
          
          Updated services:
          $(echo '${{ needs.preflight.outputs.services }}' | jq -r '.[]' | sed 's/^/- /')
          
          🤖 Automated deployment via GitHub Actions"
          
          git push origin HEAD:main
          echo "✅ Pushed deployment commit"
        fi
    
    - name: GitOps Manifest Update (Private ArgoCD Compatible)
      run: |
        echo "🔄 Updating manifests for GitOps deployment..."
        
        TARGET_ENV="${{ needs.deployment-strategy.outputs.target-env }}"
        VERSION="${{ needs.preflight.outputs.version }}"
        DEPLOYMENT_TYPE="${{ needs.deployment-strategy.outputs.deployment-type }}"
        TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        
        echo "Environment: ${TARGET_ENV}"
        echo "Version: ${VERSION}"
        echo "Deployment Type: ${DEPLOYMENT_TYPE}"
        
        # Update image tags for each service
        for service_dir in k8s/*/; do
          service=$(basename "$service_dir")
          deployment_file="${service_dir}deployment.yaml"
          
          if [[ -f "$deployment_file" && "$service" =~ ^(minute-service|eod-service|analytics-service)$ ]]; then
            echo "Updating ${service}..."
            
            # Update image tag
            NEW_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}-${service}:${{ github.ref_name }}-${{ github.sha }}"
            
            # Use yq to update the image
            yq eval "(.spec.template.spec.containers[] | select(.name == \"${service}\") | .image) = \"${NEW_IMAGE}\"" -i "$deployment_file"
            
            # Update deployment annotation for rolling restart
            yq eval ".spec.template.metadata.annotations[\"deployment.kubernetes.io/restartedAt\"] = \"${TIMESTAMP}\"" -i "$deployment_file"
            yq eval ".spec.template.metadata.annotations[\"deployment.kubernetes.io/version\"] = \"${VERSION}\"" -i "$deployment_file"
            
            echo "✅ Updated ${service}: ${NEW_IMAGE}"
          fi
        done
        
        # Store deployment info for notifications
        echo "DEPLOYMENT_TARGET=${TARGET_ENV}" >> $GITHUB_ENV
        echo "DEPLOYMENT_VERSION=${VERSION}" >> $GITHUB_ENV
        echo "DEPLOYMENT_METHOD=gitops" >> $GITHUB_ENV

  # Job 5: Post-Deployment Validation
  validate:
    runs-on: ubuntu-latest
    needs: [preflight, deploy]
    if: always() && needs.deploy.result == 'success'
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Setup validation environment
      run: |
        echo "🔍 Setting up validation environment..."
        # This would set up kubectl context for the target cluster
        echo "Target environment: ${{ needs.preflight.outputs.target-env }}"
    
    - name: Health check services
      run: |
        echo "🏥 Running post-deployment health checks..."
        
        # Use our permanent access system for validation
        if [[ -f "scripts/setup/start-permanent-access.sh" ]]; then
          echo "Using permanent access system for validation..."
          # This would leverage our permanent access system
          echo "✅ Health checks would run via permanent access URLs"
        else
          echo "ℹ️ No permanent access system found"
        fi
    
    - name: Integration smoke tests
      run: |
        echo "💨 Running smoke tests..."
        # Basic integration tests to verify deployment
        echo "✅ Smoke tests would run here"

  # Job 6: Notifications (Reliable Slack Integration)
  notify:
    runs-on: ubuntu-latest
    needs: [preflight, test, build, deploy, validate]
    if: always()
    
    steps:
    - name: Determine notification status
      id: status
      run: |
        if [[ "${{ needs.test.result }}" == "success" && "${{ needs.build.result }}" == "success" && "${{ needs.deploy.result }}" == "success" ]]; then
          echo "status=success" >> $GITHUB_OUTPUT
          echo "color=good" >> $GITHUB_OUTPUT
          echo "emoji=✅" >> $GITHUB_OUTPUT
        elif [[ "${{ needs.test.result }}" == "failure" ]]; then
          echo "status=test_failure" >> $GITHUB_OUTPUT
          echo "color=danger" >> $GITHUB_OUTPUT
          echo "emoji=❌" >> $GITHUB_OUTPUT
        elif [[ "${{ needs.build.result }}" == "failure" ]]; then
          echo "status=build_failure" >> $GITHUB_OUTPUT
          echo "color=danger" >> $GITHUB_OUTPUT
          echo "emoji=🔴" >> $GITHUB_OUTPUT
        elif [[ "${{ needs.deploy.result }}" == "failure" ]]; then
          echo "status=deploy_failure" >> $GITHUB_OUTPUT
          echo "color=danger" >> $GITHUB_OUTPUT
          echo "emoji=🚨" >> $GITHUB_OUTPUT
        else
          echo "status=unknown" >> $GITHUB_OUTPUT
          echo "color=warning" >> $GITHUB_OUTPUT
          echo "emoji=⚠️" >> $GITHUB_OUTPUT
        fi
    
    - name: Send Slack notification
      if: ${{ secrets.SLACK_WEBHOOK_URL }}
      run: |
        STATUS="${{ steps.status.outputs.status }}"
        EMOJI="${{ steps.status.outputs.emoji }}"
        COLOR="${{ steps.status.outputs.color }}"
        
        TARGET_ENV="${{ needs.deployment-strategy.outputs.target-env }}"
        DEPLOYMENT_TYPE="${{ needs.deployment-strategy.outputs.deployment-type }}"
        
        if [[ "$STATUS" == "success" ]]; then
          TITLE="ATS Deployment Successful"
          MESSAGE="All services deployed successfully to ${TARGET_ENV}"
        else
          TITLE="ATS Deployment Failed"  
          MESSAGE="Deployment failed at stage: $STATUS"
        fi
        
# Enhanced notification with comprehensive deployment info
        SERVICES_LIST=$(echo '${{ needs.preflight.outputs.services }}' | jq -r '.[]' | tr '\n' ',' | sed 's/,$//')
        DURATION=$(($(date +%s) - ${{ github.event.head_commit.timestamp && fromJSON(github.event.head_commit.timestamp) || 0 }}))
        
        # Build additional fields based on deployment status
        ADDITIONAL_FIELDS=""
        if [[ "$STATUS" == "success" && -n "$ARGOCD_APP_NAME" ]]; then
          ADDITIONAL_FIELDS=",{\"title\": \"Argo CD App\", \"value\": \"${ARGOCD_APP_NAME:-N/A}\", \"short\": true},
                            {\"title\": \"Argo CD Health\", \"value\": \"${ARGOCD_HEALTH:-N/A}\", \"short\": true}"
        fi
        
        # Include test coverage if available
        if [[ -n "${{ needs.test.outputs.coverage }}" ]]; then
          ADDITIONAL_FIELDS="${ADDITIONAL_FIELDS},{\"title\": \"Test Coverage\", \"value\": \"${{ needs.test.outputs.coverage }}%\", \"short\": true}"
        fi
        
        # Add services deployed
        ADDITIONAL_FIELDS="${ADDITIONAL_FIELDS},{\"title\": \"Services\", \"value\": \"${SERVICES_LIST}\", \"short\": false}"
        
        # Enhanced message with more context
        if [[ "$STATUS" == "success" ]]; then
          MESSAGE="🎉 Successfully deployed ${SERVICES_LIST} to ${TARGET_ENV} environment (${DEPLOYMENT_TYPE})"
          if [[ -n "$ARGOCD_HEALTH" && "$ARGOCD_HEALTH" == "Healthy" ]]; then
            MESSAGE="${MESSAGE}\n✅ Argo CD sync completed with healthy status"
          fi
        else
          MESSAGE="❌ Deployment failed at ${STATUS} stage for ${TARGET_ENV} environment (${DEPLOYMENT_TYPE})"
        fi
        
        curl -X POST -H 'Content-type: application/json' \
          --data "{
            \"attachments\": [{
              \"color\": \"$COLOR\",
              \"title\": \"$EMOJI $TITLE\",
              \"text\": \"$MESSAGE\",
              \"fields\": [
                {\"title\": \"Repository\", \"value\": \"${{ github.repository }}\", \"short\": true},
                {\"title\": \"Branch\", \"value\": \"${{ github.ref_name }}\", \"short\": true},
                {\"title\": \"Environment\", \"value\": \"${{ needs.preflight.outputs.target-env }}\", \"short\": true},
                {\"title\": \"Version\", \"value\": \"${{ needs.preflight.outputs.version }}\", \"short\": true},
                {\"title\": \"Author\", \"value\": \"${{ github.actor }}\", \"short\": true},
                {\"title\": \"Trigger\", \"value\": \"${{ github.event_name }}\", \"short\": true}
                ${ADDITIONAL_FIELDS}
              ],
              \"actions\": [
                {
                  \"type\": \"button\",
                  \"text\": \"View Workflow\",
                  \"url\": \"${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\"
                },
                {
                  \"type\": \"button\",
                  \"text\": \"View Commit\",
                  \"url\": \"${{ github.server_url }}/${{ github.repository }}/commit/${{ github.sha }}\"
                }
              ],
              \"footer\": \"ATS CI/CD Pipeline (Improved)\",
              \"footer_icon\": \"https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png\",
              \"ts\": $(date +%s)
            }]
          }" \
          ${{ secrets.SLACK_WEBHOOK_URL }}
    
    - name: Update deployment status
      run: |
        echo "📊 Final deployment status: ${{ steps.status.outputs.status }}"
        echo "Environment: ${{ needs.preflight.outputs.target-env }}"
        echo "Version: ${{ needs.preflight.outputs.version }}"