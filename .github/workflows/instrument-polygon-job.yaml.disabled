name: Instrument Polygon Job Workflow

on:
  workflow_dispatch:
    inputs:
      job_type:
        description: 'Job type (backfill or test)'
        required: true
        default: 'test'
        type: choice
        options:
          - backfill
          - test
      tickers:
        description: 'Tickers for test job (comma-separated)'
        required: false
        default: 'AAPL,MSFT,AMZN'
      debug:
        description: 'Enable debug mode'
        required: false
        default: false
        type: boolean
      memory_request:
        description: 'Memory request (e.g., 256Mi)'
        required: false
      memory_limit:
        description: 'Memory limit (e.g., 512Mi)'
        required: false
      cpu_request:
        description: 'CPU request (e.g., 100m)'
        required: false
      cpu_limit:
        description: 'CPU limit (e.g., 250m)'
        required: false
      environment:
        description: 'Target environment'
        required: true
        default: 'dev'
        type: choice
        options:
          - dev
          - intg
          - prod
      apply:
        description: 'Apply job to cluster'
        required: true
        default: false
        type: boolean

jobs:
  generate-and-apply-job:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install pyyaml
          pip install -r requirements.txt

      - name: Configure kubectl for dev
        if: ${{ github.event.inputs.environment == 'dev' }}
        uses: azure/k8s-set-context@v3
        with:
          kubeconfig: ${{ secrets.KUBE_CONFIG_DEV }}
          
      - name: Configure kubectl for intg
        if: ${{ github.event.inputs.environment == 'intg' }}
        uses: azure/k8s-set-context@v3
        with:
          kubeconfig: ${{ secrets.KUBE_CONFIG_INTG }}
          
      - name: Configure kubectl for prod
        if: ${{ github.event.inputs.environment == 'prod' }}
        uses: azure/k8s-set-context@v3
        with:
          kubeconfig: ${{ secrets.KUBE_CONFIG_PROD }}

      - name: Generate job YAML
        id: generate
        run: |
          # Create command with required parameters
          CMD="python scripts/flyte_instrument_polygon_workflow.py --job-type ${{ github.event.inputs.job_type }}"
          
          # Add optional parameters if provided
          if [ "${{ github.event.inputs.job_type }}" == "test" ] && [ -n "${{ github.event.inputs.tickers }}" ]; then
            CMD="$CMD --tickers ${{ github.event.inputs.tickers }}"
          fi
          
          if [ "${{ github.event.inputs.debug }}" == "true" ]; then
            CMD="$CMD --debug"
          fi
          
          if [ -n "${{ github.event.inputs.memory_request }}" ]; then
            CMD="$CMD --memory-request ${{ github.event.inputs.memory_request }}"
          fi
          
          if [ -n "${{ github.event.inputs.memory_limit }}" ]; then
            CMD="$CMD --memory-limit ${{ github.event.inputs.memory_limit }}"
          fi
          
          if [ -n "${{ github.event.inputs.cpu_request }}" ]; then
            CMD="$CMD --cpu-request ${{ github.event.inputs.cpu_request }}"
          fi
          
          if [ -n "${{ github.event.inputs.cpu_limit }}" ]; then
            CMD="$CMD --cpu-limit ${{ github.event.inputs.cpu_limit }}"
          fi
          
          # Create output directory if it doesn't exist
          mkdir -p k8s/generated
          
          # Add output directory parameter
          TIMESTAMP=$(date +%Y%m%d_%H%M%S)
          OUTPUT_DIR="k8s/generated"
          CMD="$CMD --output-dir $OUTPUT_DIR"
          
          # Add apply flag if requested
          if [ "${{ github.event.inputs.apply }}" == "true" ]; then
            CMD="$CMD --apply"
          fi
          
          # Run the command
          echo "Running: $CMD"
          eval $CMD
          
          # Find the most recently created YAML file in the output directory
          OUTPUT_FILE=$(ls -t $OUTPUT_DIR/*.yaml | head -n1)
          
          # Save the output file path for artifact upload
          echo "output_file=$OUTPUT_FILE" >> $GITHUB_OUTPUT

      - name: Upload job YAML as artifact
        uses: actions/upload-artifact@v4
        with:
          name: kubernetes-job-yaml
          path: ${{ steps.generate.outputs.output_file }}
          retention-days: 30

      - name: Job Summary
        run: |
          echo "## Job Generation Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- **Job Type:** ${{ github.event.inputs.job_type }}" >> $GITHUB_STEP_SUMMARY
          if [ "${{ github.event.inputs.job_type }}" == "test" ]; then
            echo "- **Tickers:** ${{ github.event.inputs.tickers }}" >> $GITHUB_STEP_SUMMARY
          fi
          echo "- **Environment:** ${{ github.event.inputs.environment }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Debug Mode:** ${{ github.event.inputs.debug }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Applied to Cluster:** ${{ github.event.inputs.apply }}" >> $GITHUB_STEP_SUMMARY
          echo "- **YAML File:** [Download Artifact](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }})" >> $GITHUB_STEP_SUMMARY
