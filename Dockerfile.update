FROM dragonflyer762/ats-genai:dev-latest

# Copy our updated populate_instrument_polygon.py to the image
COPY src/secmaster/populate_instrument_polygon.py /app/src/secmaster/populate_instrument_polygon.py

# Set environment variables
ENV PYTHONPATH=/app/src
ENV LOG_LEVEL=INFO

# Set working directory
WORKDIR /app

# Default command
CMD ["python", "-m", "src.secmaster.populate_instrument_polygon", "--help"]
