[Unit]
Description=Start Kubernetes in WSL
After=docker.service network.target
Requires=docker.service
Wants=network.target
Documentation=https://github.com/jianjun00/ats-genai/blob/main/k8s/data-agent/README.md

[Service]
Type=oneshot
ExecStart=/home/jianjun/ats-genai/scripts/start-kubernetes.sh
ExecStop=/home/jianjun/ats-genai/scripts/stop-kubernetes.sh
TimeoutStartSec=300
TimeoutStopSec=120
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s

# Output to syslog
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=wsl-kubernetes

[Install]
WantedBy=multi-user.target
