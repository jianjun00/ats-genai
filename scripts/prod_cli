#!/bin/bash
#
# ATS Production Environment CLI Wrapper
#
# This script can be symlinked to /usr/local/bin/prod_cli for global access
# Usage: prod_cli <command> [args...]
#

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Set environment variables
export PYTHONPATH="$PROJECT_ROOT/src:$PYTHONPATH"

# Production environment warning
if [[ "$1" != "health" && "$1" != "db" || "$2" != "status" ]] && [[ "$1" != "k8s" || "$2" != "status" ]] && [[ "$1" != "storage" || "$2" != "status" ]]; then
    echo "🚨 PRODUCTION ENVIRONMENT CLI 🚨"
    echo "Use with extreme caution!"
    echo
fi

# Execute the Python CLI
exec python3 "$SCRIPT_DIR/prod_cli.py" "$@"