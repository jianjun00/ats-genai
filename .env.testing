# Testing Environment Feature Flags
# Enable all advanced features for comprehensive testing

# Phase 2: Agent Networks
ENABLE_AGENT_NETWORKS=true
AGENT_NETWORKS_ROLLOUT=100.0
ENABLE_PORTFOLIO_AGENTS=true
PORTFOLIO_AGENTS_ROLLOUT=100.0
ENABLE_MARKET_GRAPH=true
MARKET_GRAPH_ROLLOUT=100.0

# Phase 3: LLM Events
ENABLE_LLM_EVENTS=true
LLM_EVENTS_ROLLOUT=100.0
ENABLE_ADAPTIVE_SELECTION=true
ADAPTIVE_SELECTION_ROLLOUT=100.0
ENABLE_EVENT_REFLECTION=true
EVENT_REFLECTION_ROLLOUT=100.0

# LLM Configuration
LLM_MODEL=mock-gpt-4
LLM_MAX_CONTEXT=8192
ENABLE_LLM_REFLECTION=true