# Development Environment Variables for Instrument Data Agent
# Copy this file to .env for local development or use source .env.dev

# Environment type
ENVIRONMENT=dev

# =====================================================================
# DATABASE CONFIGURATION
# =====================================================================
# IMPORTANT: Update these values to match your PostgreSQL configuration
# You can either:
# 1. Set individual connection parameters (DB_HOST, DB_PORT, etc.)
# 2. Set a complete DATABASE_URL
# 3. Comment out DATABASE_URL and use individual parameters
# =====================================================================

# Option 1: Individual connection parameters
# Uncomment and modify these if you're not using DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
# Update these with your actual PostgreSQL credentials
DB_USER=postgres
DB_PASSWORD=your_actual_password
TABLE_PREFIX=

# Option 2: Complete DATABASE_URL (this takes precedence if set)
# Comment this out if you want to use individual parameters above
# DATABASE_URL=postgresql://postgres:your_actual_password@localhost:5432/postgres

# =====================================================================
# API KEYS AND OTHER SETTINGS
# =====================================================================

# API Keys - Replace with your actual key if available
POLYGON_API_KEY=REPLACE_WITH_YOUR_ACTUAL_KEY

# Logging
LOG_LEVEL=INFO

# Agent configuration
# Set to true to run the agent without making actual database changes
DRY_RUN=true

# Report directory - where to save instrument update reports
REPORT_DIR=./reports

# Set timezone for consistent timestamp reporting
TZ=America/New_York
